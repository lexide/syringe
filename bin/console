#!/usr/bin/env php
<?php
$rootDir = dirname(__DIR__);

include_once("$rootDir/vendor/autoload.php");

use Lexide\Syringe\Command\SchemaLintCommand;
use Lexide\Syringe\Schema\SchemaLinter;
use Symfony\Component\Console\Application;

// linter
$linter = new SchemaLinter();
$lintCommand = new SchemaLintCommand($linter);

$app = new Application("Syringe dev tools", "1.0");
// handle deprecated methods
if (method_exists($app, "addCommand")) {
    $app->addCommand($lintCommand);
} else {
    $app->add($lintCommand);
}

$app->run();